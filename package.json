{
  "name": "identity",
  "version": "0.1.2",
  "private": true,
  "description": "Passkeys-first, passwordless first-party identity for Pegma hosts.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b --pretty false && tsc -p tsconfig.test.json --pretty false",
    "clean": "tsc -b --clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release:check": "node scripts/release-package.mjs check",
    "release:pack": "node scripts/release-package.mjs pack",
    "release:publish": "node scripts/release-package.mjs publish",
    "release:registry:check": "node scripts/release-package.mjs registry-check",
    "test": "pnpm run build && node --test scripts/*.test.mjs && vitest run"
  },
  "devDependencies": {
    "@azure/data-tables": "13.3.1",
    "@pegma/storage-azure-tables": "0.4.0",
    "@types/node": "26.1.1",
    "@types/tr46": "5.0.1",
    "@types/unorm": "1.3.31",
    "azurite": "3.36.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
